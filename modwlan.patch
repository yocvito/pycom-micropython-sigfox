+ *       print(info.detail.ssid, info.detail.bssid)
+ */
+STATIC mp_obj_t wlan_parse_frame(mp_obj_t self_in, mp_obj_t buf_in) {
+    (void)self_in;
+    mp_buffer_info_t buf;
+    mp_get_buffer_raise(buf_in, &buf, MP_BUFFER_READ);
+    return mod_libwifi_parse_frame((const uint8_t *)buf.buf, buf.len);
