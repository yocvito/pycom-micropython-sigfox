 esp32/mods/modlibwifi.c | 381 ++++++++++++++++++++++++++++++++++++++++
 esp32/mods/modlibwifi.h |  52 ++++++
 esp32/mods/modwlan.c    |  52 ++++++
 5 files changed, 538 insertions(+)
 create mode 100644 esp32/mods/modlibwifi.c
 create mode 100644 esp32/mods/modlibwifi.h

